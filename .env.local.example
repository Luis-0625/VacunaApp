# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo servidor, nunca exponer

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="VacunaApp <recordatorios@tu-dominio.com>"

# Twilio (WhatsApp / SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # número sandbox o aprobado
# Si prefieres SMS en lugar de WhatsApp, pon TWILIO_USE_SMS=true y TWILIO_SMS_FROM
TWILIO_USE_SMS=false
TWILIO_SMS_FROM=+1xxxxxxxxxx
# Plantillas aprobadas en Twilio (Content SID HX...).
# Vacío = mensaje de texto libre (solo funciona en el sandbox).
TWILIO_WHATSAPP_CONTENT_SID=      # recordatorio: {{1}} nombre, {{2}} fecha, {{3}} dosis, {{4}} vacuna, {{5}} centro
# Campañas de pacientes atrasados: {{1}} nombre, {{2}} centro, {{3}} dosis, {{4}} vacuna, {{5}} fecha
TWILIO_CAMPANA_CONTENT_SID=
# Plantilla aprobada para enviar el carné digital: {{1}} nombre, {{2}} centro, {{3}} enlace
TWILIO_CARNE_CONTENT_SID=

# En local, expón la app con ngrok (ngrok http 3000) y usa su URL https en APP_URL y TWILIO_WEBHOOK_URL.
# URL pública de la app para los enlaces del carné (en Vercel se detecta sola)
APP_URL=                          # ej. https://abc123.ngrok-free.app
# URL pública exacta del webhook si la app está detrás de un proxy (para validar la firma de Twilio)
TWILIO_WEBHOOK_URL=               # ej. https://abc123.ngrok-free.app/api/whatsapp/webhook

# Reprogramación por WhatsApp (días de atención y cupos se configuran en la pantalla Establecimiento)
REPROGRAMAR_OPCIONES=4             # fechas que se ofrecen al paciente

# Cron (Vercel envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=genera-un-string-largo-aleatorio

# Teléfonos y zona horaria
DEFAULT_COUNTRY_CODE=57
APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=57
